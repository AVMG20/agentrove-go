# --- Required ---
# 32+ random characters, e.g. `openssl rand -hex 32`.
SECRET_KEY=

# --- Ports (docker compose) ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Storage ---
# Absolute host path of the storage dir. Docker sandboxes bind-mount workspace
# dirs from here, so it must be the path as the Docker daemon sees it.
HOST_STORAGE_PATH=${PWD}/storage

# --- Sandboxes ---
DOCKER_IMAGE=agentrove-sandbox:latest
# DOCKER_NETWORK=agentrove-sandbox-net
# Stop a workspace container after this many idle seconds (no running turn,
# terminal or agent process). It restarts transparently on next use.
# SANDBOX_IDLE_TTL_SECONDS=900
# Close an idle per-chat Claude process after this many seconds (it resumes
# its session on the next message).
# CHAT_PROCESS_IDLE_TTL_SECONDS=600
# DOCKER_MEM_LIMIT=8g
# DOCKER_PIDS_LIMIT=
# DOCKER_NODE_MAX_OLD_SPACE_MB=8192

# --- Claude auth for agents ---
# Each user can run `claude` in any workspace terminal and log in once: the
# login is stored per user under STORAGE_PATH/agent-homes and shared by all of
# their sandboxes. Or provide a token / proxy for everyone:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# Extra agent env, one KEY=VALUE per line.
# AGENT_ENV=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/api/v1/ws

# --- Optional ---
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=http://localhost:3000
# BASE_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:3000
# REGISTRATION_DISABLED=false
# REQUIRE_EMAIL_VERIFICATION=false
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# AGENTROVE_MCP_ENABLED=true
# AGENTROVE_ARTIFACTS_ENABLED=true
# AGENTROVE_INTERNAL_URL=http://api:8080
# MAX_UPLOAD_SIZE=
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=
# MAIL_FROM=noreply@agentrove.local
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
